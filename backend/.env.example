NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DB_PATH=./cms.sqlite
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_FIRST_NAME=Impact
ADMIN_LAST_NAME=Administrator
SEED_DEMO_DATA=false
SEED_DIRECTORY_DATA=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
# Password reset email (Resend API key and a verified sender)
RESEND_API_KEY=
EMAIL_FROM=Impact Arlington <no-reply@example.org>
# Public frontend URL; defaults to the first CLIENT_ORIGIN entry
PASSWORD_RESET_URL=http://localhost:5173
# Stripe-hosted Store Checkout. Secret keys belong only on the backend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public frontend URL; HTTPS in production. Defaults to the first CLIENT_ORIGIN.
STORE_URL=http://localhost:5173
